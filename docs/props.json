      "required": false,
      "default": null,
      "doc": ""
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false",
      "doc": "Shows a spinner and blocks activation while keeping the button focusable."
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "required": false,
      "default": "'md'",
      "doc": ""
    },
    {
      "name": "variant",
      "type": "'primary' | 'ink' | 'secondary' | 'ghost' | 'danger'",
      "required": false,
      "default": "'primary'",
      "doc": ""
    }
  ],
  "IconButton": [
    {
      "name": "icon",
      "type": "ReactNode",
      "required": true,
      "default": null,
      "doc": ""
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "default": null,
      "doc": "Accessible name; required because the button only shows an icon."
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "default": null,
      "doc": "Render this element (e.g. a router link) instead of a <button>; it shows the icon."
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "default": null,
      "doc": "Only with `asChild`: the element to render."
    },
    {
      "name": "size",
      "type": "'md' | 'lg'",
      "required": false,
      "default": "'md'",
      "doc": ""
    },
    {
      "name": "variant",
      "type": "'disc' | 'outline' | 'ghost'",
      "required": false,
      "default": "'outline'",
      "doc": "`disc` is the portfolio's ink circle that turns vermilion on hover."
    }
  ],
  "Link": [
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "default": null,
      "doc": "Render the single child element (e.g. Next.js or React Router `Link`) with Papier's link style."
    },
    {
      "name": "external",
      "type": "boolean",
      "required": false,
      "default": null,
      "doc": "Opens in a new tab with safe rel and an announced hint."
    },
    {
      "name": "variant",
      "type": "'underline' | 'quiet' | 'arrow' | 'accent'",
      "required": false,
      "default": "'underline'",
      "doc": "`underline`: a resting line that darkens on hover. `quiet`: the line rises only on hover. `arrow`: label with a thin arrow that nudges up-right."
    }
  ],
  "Surface": [
    {
      "name": "as",
