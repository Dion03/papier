{
  "Papier": [
    {
      "name": "labels",
      "type": "Partial<PapierLabels>",
      "required": false,
      "default": null,
      "doc": "Override built-in strings, e.g. `englishLabels` or a partial set."
    },
    {
      "name": "motion",
      "type": "'full' | 'reduced'",
      "required": false,
      "default": "'full'",
      "doc": "`reduced` makes every Papier transition instant, independent of the OS setting."
    },
    {
      "name": "theme",
      "type": "'light' | 'dark' | 'system'",
      "required": false,
      "default": "'light'",
      "doc": "Colour theme for everything inside. `system` follows the OS setting."
    }
  ],
  "Text": [
    {
      "name": "as",
      "type": "ElementType",
      "required": false,
      "default": null,
      "doc": "Element to render; defaults to a sensible tag per variant."
    },
    {
      "name": "tone",
      "type": "'default' | 'muted' | 'accent'",
      "required": false,
      "default": "'default'",
      "doc": ""
    },
    {
      "name": "variant",
      "type": "'display' | 'headline' | 'title' | 'subtitle' | 'body' | 'body-lg' | 'small' | 'label'",
      "required": false,
      "default": "'body'",
      "doc": "Typographic role from the Papier scale."
    }
  ],
  "Button": [
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "default": null,
      "doc": "Render the single child element (e.g. a router link) with the button's look and behaviour instead of a <button>. Its children become the label."
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "default": null,
      "doc": ""
    },
    {
