      "default": "'flat'",
      "doc": "`object` adds the portfolio's tactile shadow with light top and dark bottom edge. Prose stays flat."
    },
    {
      "name": "material",
      "type": "'ink' | 'paper' | 'sunken' | 'sage' | 'sage-soft' | 'coral'",
      "required": false,
